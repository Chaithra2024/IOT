int Smoke_sensor = 0;

void setup() {
  pinMode(A0, INPUT);

  Serial.begin(9600);

  pinMode(5, OUTPUT);  // LED
  pinMode(7, OUTPUT);  // Buzzer
}

void loop() {

  Smoke_sensor = analogRead(A0);

  Serial.println(Smoke_sensor);

  if (Smoke_sensor >= 60) {
    digitalWrite(5, HIGH);
  }
  else {
    digitalWrite(5, LOW);
  }

  if (Smoke_sensor >= 65) {
    digitalWrite(7, HIGH);
  }
  else {
    digitalWrite(7, LOW);
  }

  delay(10);  // Delay a little bit to improve simulation performance
}